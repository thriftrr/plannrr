# --- Personal / single-user mode (optional, LOCAL DEV ONLY) ------------------
# Your OWN token from https://app.ynab.com/settings/developer — never anyone
# else's. When set, `npm run dev` works without signing in. Production ignores
# it: there, YNAB is connected only through "Sign in with YNAB" (below).
NUXT_YNAB_PERSONAL_ACCESS_TOKEN=

# Serve built-in sample data instead of calling YNAB (no token needed)
# NUXT_YNAB_MOCK=1

# --- Accounts (required in production) ---------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
NUXT_SESSION_SECRET=
# Encrypts stored YNAB tokens at rest (defaults to the session secret). The
# name is historical; changing the value orphans every stored token.
NUXT_PAT_SECRET=

# --- Cloudflare Email Sending (magic links) ----------------------------------
# In dev, emails print to the server console instead.
# The from-domain must be onboarded: npx wrangler email sending enable <domain>
NUXT_CF_ACCOUNT_ID=
NUXT_CF_EMAIL_TOKEN=
NUXT_EMAIL_FROM=
# Absolute origin used in emailed links — REQUIRED in production (pins the
# magic-link domain so a spoofed Host header can't redirect tokens)
NUXT_APP_ORIGIN=

# --- Self-hosting knobs ---------------------------------------------------------
# 1 when a reverse proxy in front of you sets X-Forwarded-For (not needed on Cloudflare)
NUXT_TRUST_PROXY=
# sign-up ceiling for a public instance (default 250)
NUXT_MAX_USERS=

# --- "Sign in with YNAB" (OAuth) ---------------------------------------------------
# Create an OAuth application under YNAB → Account Settings → Developer with
# redirect URI  <NUXT_APP_ORIGIN>/api/ynab/oauth/callback . This is the only
# way anyone connects YNAB; leave blank and the instance offers export-zip
# imports and hand-built plans only.
NUXT_YNAB_CLIENT_ID=
NUXT_YNAB_CLIENT_SECRET=

# --- Admin ---------------------------------------------------------------------
# Comma-separated emails that can open the feedback inbox and receive feedback
# notifications. Nobody is admin until this is set.
NUXT_ADMIN_EMAILS=

# --- Cloudflare deployment (make deploy) ----------------------------------------
# Create these once in your own account, then paste the ids here:
#   npx wrangler d1 create plannrr-db
#   npx wrangler kv namespace create plannrr-kv
#   npx wrangler kv namespace create plannrr-cache
#   npx wrangler r2 bucket create plannrr-blob
NUXT_CF_WORKER_NAME=plannrr
NUXT_CF_D1_DATABASE_NAME=plannrr-db
NUXT_CF_D1_DATABASE_ID=
NUXT_CF_KV_ID=
NUXT_CF_KV_CACHE_ID=
NUXT_CF_R2_BUCKET=plannrr-blob
