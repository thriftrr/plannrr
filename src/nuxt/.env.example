# --- Personal / single-user mode (optional) ---------------------------------
# Create a token at https://app.ynab.com/settings/developer
# When set, the sandbox works without signing in (your own local instance).
NUXT_YNAB_PERSONAL_ACCESS_TOKEN=

# Serve built-in sample data instead of calling YNAB (no token needed)
# NUXT_YNAB_MOCK=1

# --- Accounts (required in production) ---------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
NUXT_SESSION_SECRET=
# Encrypts stored YNAB tokens at rest (defaults to the session secret)
NUXT_PAT_SECRET=

# --- Cloudflare Email Sending (magic links) ----------------------------------
# In dev, emails print to the server console instead.
# The from-domain must be onboarded: npx wrangler email sending enable <domain>
NUXT_CF_ACCOUNT_ID=
NUXT_CF_EMAIL_TOKEN=
NUXT_EMAIL_FROM=
# Absolute origin used in emailed links (defaults to the request origin)
NUXT_APP_ORIGIN=
